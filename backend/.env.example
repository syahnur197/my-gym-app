# Copy to .env; do NOT commit .env
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./gym.db
PORT=8080
# Set true when served over HTTPS in production
COOKIE_SECURE=false
# Required only when using the bundled Cloudflare Tunnel service.
TUNNEL_TOKEN=
